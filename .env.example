# PostgreSQL
POSTGRES_USER=coco
POSTGRES_PASSWORD=coco_dev_password
POSTGRES_DB=coco
DATABASE_URL=postgresql://coco:coco_dev_password@localhost:5432/coco

# Redis
REDIS_URL=redis://localhost:6379/0

# Backend
SECRET_KEY=change-me-to-a-random-secret-in-production
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081

# Next.js dashboards
NEXT_PUBLIC_API_URL=http://localhost:8000

# Expo mobile
EXPO_PUBLIC_API_URL=http://localhost:8000

# Groq AI (voice chatbot)
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3
